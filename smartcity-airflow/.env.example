# ╔══════════════════════════════════════════════════════════════════╗
# ║  SmartCity Airflow — Environment Variables                       ║
# ║  cp .env.example .env  ثم عدّل القيم                            ║
# ╚══════════════════════════════════════════════════════════════════╝

# ✅ مسار مشروع SmartCityAnalyzer على جهازك
# مثال Windows: C:/Users/YourName/Downloads/SmartCityAnalyzer-main/SmartCityAnalyzer-main
# مثال Mac/Linux: /home/username/SmartCityAnalyzer-main
SMARTCITY_PROJECT_PATH=C:/Users/YourName/Downloads/SmartCityAnalyzer-main/SmartCityAnalyzer-main

# ✅ نفس المسار للـ docker -v mounts (لازم يكون Host path)
SMARTCITY_HOST_PATH=C:/Users/YourName/Downloads/SmartCityAnalyzer-main/SmartCityAnalyzer-main

# ─── SmartCity Pipeline Configs ───────────────────────────────────
SMARTCITY_NETWORK=smartcity_default

# SmartCity PostgreSQL (Bronze Layer)
SMARTCITY_PG_HOST=postgres
SMARTCITY_PG_PORT=5432
SMARTCITY_PG_DB=smartcity
SMARTCITY_PG_USER=smartcity
SMARTCITY_PG_PASSWORD=smartcity123

# SmartCity SQL Server (Phase 3 DWH)
SQLSERVER_HOST=host.docker.internal
SQLSERVER_PORT=1433
SQLSERVER_DB=SmartCity
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourStrong@Passw0rd

# ─── Airflow Internal ──────────────────────────────────────────────
AIRFLOW_UID=50000
